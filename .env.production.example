# Production settings for the Hostinger VPS (docs/deployment/hostinger.md).
# On the server:  cp .env.production.example .env.production  &&  chmod 600 .env.production
# Never commit .env.production. Replace every <...> value. The values here are
# placeholders, not credentials.
#
# Three groups: (1) read by Docker Compose and the helper scripts only,
# (2) read by the backend (the names are the backend's own settings,
# backend/app/core/config.py), (3) optional. compose.production.yaml forces
# APP_ENV=production, APP_DEBUG=false, SMS_PROVIDER=termii, DATABASE_URL and
# FRONTEND_URL, so setting those here has no effect.

# --- 1. Compose and scripts ----------------------------------------------------
# The public domain, no scheme and no www. Caddy also serves www.<this> as a
# redirect. FRONTEND_URL and the frontend's API address are built from it.
SITE_DOMAIN=mmiriomadelivery.com

# Password of the "mmirioma" database user. Use letters and digits only (it goes
# into a URL):  openssl rand -hex 24
POSTGRES_PASSWORD=<generate-with-openssl-rand-hex-24>

# Public values baked into the frontend when the image is built (docs say "build",
# so change them and rebuild). Same as SUPPORT_PHONE below; optional.
# VITE_SUPPORT_PHONE=+2348133774902
# VITE_SUPPORT_WHATSAPP=
# The message form on /contact (#344). Leave it off until the four conditions in
# docs/design/contact.md ("Switching the form on") are met, then set it to true
# and rebuild: deploy/prod.sh build api.
# VITE_CONTACT_FORM_ENABLED=false

# OSRM routing files (compose.production.yaml, service "osrm", docs/deployment/hostinger.md
# section 16). The folder on the VPS that deploy/osrm-build.sh's output is copied to.
# Only used when OSRM is started on purpose; the default is ./osrm-data in the repository.
# OSRM_DATA_DIR=/srv/mmirioma/osrm-data

# Backups (deploy/production-backup.sh; the app does not read these).
# Folder on the VPS, and how many days to keep (the privacy notice allows 30).
# BACKUP_DIR=/var/backups/mmirioma
# BACKUP_KEEP_DAYS=30
# Off-VPS copy: an rclone remote and folder, for example  offsite:mmirioma-backups
# PLACEHOLDER: the target is not chosen yet. Until it is set, backups stay on the
# VPS only, and the script says so on every run.
# BACKUP_RCLONE_REMOTE=

# --- 2. Backend (required) -----------------------------------------------------
# 32+ characters; changing it signs everyone out.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=<generate-at-least-32-characters>

# SMS (FR-003, FR-050). Production refuses the mock provider.
# Sender ID registered with Termii; the "dnd" channel must be activated by Termii.
TERMII_API_KEY=<termii-api-key>
TERMII_SENDER_ID=<registered-sender-id>
TERMII_CHANNEL=dnd
# TERMII_BASE_URL=https://api.ng.termii.com
# SMS_TIMEOUT_SECONDS=10

# --- 3. Backend (optional) -----------------------------------------------------
# Support contact in E.164 form (FR-055). Unset uses the official number.
# SUPPORT_PHONE=+2348133774902
# SUPPORT_WHATSAPP_ENABLED=false
# PILOT_WATER_CATEGORY=utility
# QUOTE_VALIDITY_MINUTES=60
# Current driver location freshness (#410), in positive whole seconds.
# DRIVER_LOCATION_FRESHNESS_SECONDS=300
# SESSION_MAX_AGE_SECONDS=604800
# Leave the cookie flags alone: Secure is on in production, SameSite is lax.
# SESSION_COOKIE_SAMESITE=lax

# Not supported by the code yet, so there are no settings for them: Resend
# (email), Geoapify (maps) and Paystack (payments). Add them in the pull request
# that adds the integration.

# Copy to .env.local:  cp .env.example .env.local
# Only VITE_-prefixed variables reach the browser; never put secrets here.

# Base URL of the FastAPI backend (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000

# Serve typed mock data from src/mocks instead of calling the API.
# 'true' while backend endpoints for the new design do not exist yet.
VITE_USE_MOCKS=true

# Public VAPID key for phone (push) notifications, base64url. Public by
# design; the matching private key lives only on the backend. Leave empty
# until the push endpoints exist (docs/api/push.md).
VITE_VAPID_PUBLIC_KEY=

# Google Analytics 4 measurement ID for the public pages (public, like every
# VITE_ value), e.g. G-XXXXXXXXXX. Leave empty to turn analytics and the
# cookie banner off. Analytics loads only after a visitor accepts it.
VITE_GA_MEASUREMENT_ID=

# Google Maps browser key for "Use my location" (public, like every VITE_
# value): restrict it to the site's domains and to the Maps JavaScript and
# Geocoding APIs in Google Cloud. Leave empty to hide the button.
VITE_GOOGLE_MAPS_API_KEY=

# Public address of the site for canonical links, the share image and
# sitemap.xml (built into index.html, robots.txt and sitemap.xml). Optional:
# without it the build uses VITE_API_BASE_URL, because production serves the
# site and /api from one origin.
VITE_SITE_URL=

# Copy to .env.local:  cp .env.example .env.local
# Only VITE_-prefixed variables reach the browser; never put secrets here.

# Base URL of the FastAPI backend (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000

# Customer support contacts shown on the welcome and sign-in screens. Public.
# The real pilot numbers are not decided yet (docs/design/authentication.md,
# open question 1); leave empty until they are, and the screens hide the
# call/WhatsApp buttons instead of showing a made-up number.
VITE_SUPPORT_PHONE=
VITE_SUPPORT_WHATSAPP=

# Data for the customer and staff order screens: `api` (the real backend) or
# `mock` (simulated orders, for design review without a backend). Unset: `api`.
VITE_ORDERS_SOURCE=

# Copy to .env and fill in values:  cp .env.example .env
# .env is read by Docker Compose and by the backend. Never commit it.

# --- Docker Compose (PostgreSQL/PostGIS) -------------------------------------
# Password for the local "mmirioma" database user. Choose your own value.
POSTGRES_PASSWORD=change-me

# --- Backend (FastAPI) --------------------------------------------------------
# development | test | production
APP_ENV=development

# Enables SQL echo and FastAPI debug tracebacks. Must be false in production.
APP_DEBUG=false

# Required. Must use the postgresql+asyncpg:// scheme. Use the same password as
# POSTGRES_PASSWORD above (URL-encode special characters). Alembic derives its
# synchronous psycopg URL from this value automatically.
DATABASE_URL=postgresql+asyncpg://mmirioma:change-me@localhost:5432/mmirioma

# Exact origin of the frontend, used for CORS with credentials. No trailing path.
FRONTEND_URL=http://localhost:5173

# Secret for signing future session cookies. Optional in development (a random
# per-process value is generated); required in production, 32+ characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keys session-token hashes and CSRF tokens; changing it signs everyone out.
SESSION_SECRET=

# Session lifetime in seconds (300 to 2592000). Default 604800 = 7 days.
# SESSION_MAX_AGE_SECONDS=604800

# Secure flag on the session cookie. Leave unset: on in production, off for
# plain-http local development. Must not be false in production.
# SESSION_COOKIE_SECURE=

# lax (default), strict, or none. Use none only when the frontend and API are on
# different sites; it requires a secure cookie.
# SESSION_COOKIE_SAMESITE=lax

# Customer support number in E.164 form, used in SMS templates (FR-055).
# Leave unset to use the official number, +2348133774902.
# SUPPORT_PHONE=+2348133774902
# WhatsApp support on the support number (FR-055). GET /public/contact returns
# it as "whatsapp" only when true. Confirmed active on 2026-10-26 (#8): set
# true for the pilot; false switches it off without a code change.
# SUPPORT_WHATSAPP_ENABLED=false

# Pricing (docs/api/order-details-and-price.md). The one water category every
# pilot quote uses (utility or potable; potable only with a lab-verified
# source), and how many minutes a quote can be ordered.
# PILOT_WATER_CATEGORY=utility
# QUOTE_VALIDITY_MINUTES=60

# SMS provider for verification codes and P0 notifications (FR-003, FR-050):
# mock (default; sends nothing and logs the message on this machine) or termii.
# Production refuses to start with mock. To prove live SMS on a team phone, set
# termii here and run python -m app.modules.messaging.live_test (docs/features/sms.md).
# SMS_PROVIDER=mock
# Termii settings, required when SMS_PROVIDER=termii. Use the base URL shown on
# your Termii dashboard. The sender ID must be registered with Termii. The dnd
# channel (recommended for OTPs) must be activated on the account by Termii, for
# every network (MTN, Airtel, Glo, 9mobile). Never use generic for verification
# codes: it is a promotional route and does not reach DND numbers. See
# docs/features/sms.md, "Delivery to every network".
# TERMII_BASE_URL=https://api.ng.termii.com
# TERMII_API_KEY=
# TERMII_SENDER_ID=
# TERMII_CHANNEL=dnd
# SMS_TIMEOUT_SECONDS=10

# Built frontend served by the API on the same origin (production image only;
# the Dockerfile sets it). Leave unset locally: Vite serves the frontend.
# FRONTEND_DIST_DIR=
